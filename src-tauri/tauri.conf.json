{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SESM Desktop", "version": "0.1.0", "identifier": "net.aptlantis.sesm-desktop",
  "build": { "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build", "devUrl": "http://127.0.0.1:1420", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "SESM Desktop · Aptlantis-Factor", "width": 1440, "height": 940, "minWidth": 980, "minHeight": 640, "dragDropEnabled": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'", "capabilities": ["main"] }
  },
  "bundle": { "active": true, "targets": ["appimage", "app", "dmg"], "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"], "resources": ["../README.md", "../docs/RECOVERY.md", "../docs/TRUST.md", "../docs/releases/0.1.0.md"] }
}
